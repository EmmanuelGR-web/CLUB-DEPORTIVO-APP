# =========================================================
# VARIABLES DE ENTORNO - Backend CLUB DEPORTIVO
# Copiar este archivo como ".env" y completar con tus datos reales.
# NUNCA subir el archivo ".env" real a GitHub (ya está en .gitignore).
# =========================================================

# --- Servidor ---
PUERTO=3000
ENTORNO=desarrollo
# Dominios del frontend separados por coma. Vacío = cualquiera (desarrollo).
CORS_ORIGENES=

# --- Base de datos PostgreSQL (Supabase) ---
DB_HOST=localhost
DB_PUERTO=5432
DB_USUARIO=postgres
DB_CONTRASENA=cambiar_esto
DB_NOMBRE=club_san_martin
# true en producción para conectarse cifrado a Supabase
DB_SSL=false

# --- Autenticación JWT ---
JWT_SECRETO=cambiar_por_una_clave_larga_y_aleatoria
JWT_EXPIRACION=1d

# --- Almacenamiento de imágenes (Supabase Storage / Cloudflare R2) ---
STORAGE_URL=
STORAGE_CLAVE=
STORAGE_BUCKET=carnets-socios
